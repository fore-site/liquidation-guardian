# --- KeeperHub ---
# API key from app.keeperhub.com -> Settings -> API Keys -> Organisation tab (starts with kh_)
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# --- Chain config ---
# Sepolia testnet by default (free test ETH). 11155111 = Sepolia, 8453 = Base mainnet.
CHAIN_ID=11155111

# Your wallet address — the one holding the Aave position. This can be your own
# existing EOA connected to KeeperHub (delegated via EIP-7702), not necessarily a
# KeeperHub-provisioned Turnkey wallet. Read-only reference for scripts + dashboard.
WALLET_ADDRESS=0xyour_wallet_address

# --- LLM (decision layer) ---
# Used only when a position is at risk, to decide the cheapest fix.
# Any OpenAI-compatible provider works — point the base URL at the provider's
# /v1 endpoint. The code is provider-agnostic; the provider lives here.
# Example (OpenRouter): key from openrouter.ai (Settings → Keys), base URL
# https://openrouter.ai/api/v1, model deepseek/deepseek-v4-flash-0731.
LLM_API_KEY=sk-or-your_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Per-attempt LLM budget in ms before we fall back to deterministic sizing (default 15000).
# LLM_TIMEOUT_MS=15000

# --- Guardian tuning ---
# Health factor below this = at risk (Aave liquidates at 1.0). Act with a safety margin.
HEALTH_FACTOR_THRESHOLD=1.15
# Target health factor to restore to after a fix.
HEALTH_FACTOR_TARGET=1.5

# --- Event-driven watcher (reactive trigger) ---
# Polls the Aave Pool for the events that move a position's HF (supply/repay/
# borrow/withdraw/liquidation + throttled oracle price updates) and re-checks
# affected positions immediately instead of waiting for the next watch-loop tick.
# Requires the bot to be running (TELEGRAM_BOT_TOKEN set).
# EVENT_WATCH_ENABLED=true
# EVENT_POLL_MS=5000
# PRICE_EVENT_THROTTLE_MS=30000
# MIN_RE_READ_MS=15000

# --- RPC providers (the event watcher + rescue history read from the chain) ---
# Public Sepolia RPC used to read Aave Pool events + rescue history. A default
# public node is used if unset; override if you hit rate limits.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional extra RPC providers (comma-separated) for failover + request pacing —
# e.g. an Alchemy/QuickNode/Infura Sepolia endpoint. The primary endpoint is tried
# first, then each fallback in turn; a provider that errors is cooled down for 60s
# while traffic shifts to the healthy ones. Leave unset to run on the default alone.
# SEPOLIA_RPC_URLS=https://eth-sepolia.g.alchemy.com/v2/KEY,https://sepolia.infura.io/v3/KEY,https://eth-sepolia.g.alchemy.com/v2/95kPektthdEQaVg4Eu00BshnJfnghVYE

# --- Dashboard (read-only UI) ---
# The dashboard's API server needs NO secrets of its own — each user enters their
# own KeeperHub key + wallet in the onboarding form, and it's held server-side per
# session. These are optional overrides only:
# Port for the dashboard API (default 8787). The Vite dev server (web/) proxies /api here.
# DASHBOARD_PORT=8787

# --- Server store (required to run server/serve.ts) ---
# 32-byte master key that encrypts each user's KeeperHub key at rest (AES-256-GCM).
# Generate one:  openssl rand -hex 32
GUARDIAN_MASTER_KEY=your_64_hex_char_master_key_here
# Redis connection URL for the shared credential + watch store. With docker compose
# this is overridden to redis://redis:6379; locally, run `redis-server` (or Upstash).
REDIS_URL=redis://localhost:6379

# --- Telegram bot + Mini App (optional — enables the phone-native face) ---
# Bot token from @BotFather (/newbot). Leave unset to run as the HTTP dashboard only.
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Public HTTPS URL the Mini App is served from — register it with @BotFather
# (/setmenubutton or via the bot's Mini App settings). In dev, tunnel to this app
# (cloudflared/ngrok) since Telegram requires HTTPS; the container serves web/dist on 8787.
WEBAPP_URL=https://your_public_https_url_here
# How often the watch loop re-reads every stored position, in ms (default 60000).
WATCH_INTERVAL_MS=60000

