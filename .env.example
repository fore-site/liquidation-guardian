# --- KeeperHub ---
# API key from app.keeperhub.com -> Settings -> API Keys -> Organisation tab (starts with kh_)
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# --- Chain config ---
# Sepolia testnet by default (free test ETH). 11155111 = Sepolia, 8453 = Base mainnet.
CHAIN_ID=11155111

# Your wallet address — the one holding the Aave position. This can be your own
# existing EOA connected to KeeperHub (delegated via EIP-7702), not necessarily a
# KeeperHub-provisioned Turnkey wallet. Read-only reference for scripts + dashboard.
WALLET_ADDRESS=0xyour_wallet_address

# --- LLM (decision layer) ---
# Used only when a position is at risk, to decide the cheapest fix.
# Gemini API key (primary) — from aistudio.google.com (starts with AQ.). The
# decision layer tries Gemini first, then the NVIDIA fallback, then deterministic
# sizing. The free tier rate-limits hard (~15 RPM) and returns 503 under load —
# if you hit that, the fallback chain handles it.
GEMINI_API_KEY=AQ.your_key_here
# Model on the primary (Gemini) decision layer (default gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
# Optional NVIDIA NIM fallback — from build.nvidia.com, Integrate tab (starts with
# nvapi-). NVIDIA cold-starts slowly (up to ~90s on first call), so it sits behind
# Gemini, not in front.
NVIDIA_API_KEY=nvapi-your_key_here
# Model served by the NVIDIA fallback (their hosted catalog, e.g. deepseek-ai/deepseek-v4-flash).
LLM_MODEL=deepseek-ai/deepseek-v4-flash
# Optional: route NVIDIA fallback calls through any OpenAI-compatible endpoint
# (NVIDIA NIM is OpenAI-compatible). Leave as-is to hit https://integrate.api.nvidia.com/v1.
BASE_URL=https://integrate.api.nvidia.com/v1
# Per-attempt LLM budget in ms before we move to the next provider (default 15000).
# NVIDIA cold-starts slowly — if the fallback times out, the chain moves on to
# deterministic sizing, but raise this if you want the fallback to answer.
# LLM_TIMEOUT_MS=15000

# --- Guardian tuning ---
# Health factor below this = at risk (Aave liquidates at 1.0). Act with a safety margin.
HEALTH_FACTOR_THRESHOLD=1.15
# Target health factor to restore to after a fix.
HEALTH_FACTOR_TARGET=1.5

# --- Monitor workflow (the "watches" half, deployed to KeeperHub) ---
# Cron for the Schedule trigger, UTC. Default: every 10 minutes.
SCHEDULE_CRON=*/10 * * * *
# Optional: only used with `npm run deploy-workflow -- --with-http`. The in-workflow
# HTTP handoff node is a KeeperHub *Pro* feature; on the free plan the monitor ends
# at the Condition and the Guardian is triggered out-of-band, so you can leave this
# unset. On Pro, point it at a tunnel to your Guardian, or a webhook.site URL to
# watch the payload during the demo. Not a secret.
GUARDIAN_WEBHOOK_URL=https://your_guardian_webhook_here

# --- Dashboard (read-only UI) ---
# The dashboard's API server (server/serve.ts) needs NO secrets of its own — each
# user enters their own KeeperHub key + wallet in the onboarding form, and it's held
# server-side per session. These are optional overrides only:
# Port for the dashboard API (default 8787). The Vite dev server (web/) proxies /api here.
# DASHBOARD_PORT=8787
# Public Sepolia RPC used to read rescue history from Aave Pool events. A default
# public node is used if unset; override if you hit rate limits.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Server store (required to run server/serve.ts) ---
# 32-byte master key that encrypts each user's KeeperHub key at rest (AES-256-GCM).
# Generate one:  openssl rand -hex 32
GUARDIAN_MASTER_KEY=your_64_hex_char_master_key_here
# Redis connection URL for the shared credential + watch store. With docker compose
# this is overridden to redis://redis:6379; locally, run `redis-server` (or Upstash).
REDIS_URL=redis://localhost:6379

# --- Telegram bot + Mini App (optional — enables the phone-native face) ---
# Bot token from @BotFather (/newbot). Leave unset to run as the HTTP dashboard only.
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Public HTTPS URL the Mini App is served from — register it with @BotFather
# (/setmenubutton or via the bot's Mini App settings). In dev, tunnel to this app
# (cloudflared/ngrok) since Telegram requires HTTPS; the container serves web/dist on 8787.
WEBAPP_URL=https://your_public_https_url_here
# How often the watch loop re-reads every stored position, in ms (default 60000).
WATCH_INTERVAL_MS=60000

