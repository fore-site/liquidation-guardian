# --- KeeperHub ---
# API key from app.keeperhub.com -> Settings -> API Keys -> Organisation tab (starts with kh_)
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# --- Chain config ---
# Sepolia testnet by default (free test ETH). 11155111 = Sepolia, 8453 = Base mainnet.
CHAIN_ID=11155111

# Your KeeperHub-provisioned wallet address (Turnkey). Read-only reference for scripts.
WALLET_ADDRESS=0xyour_wallet_address

# --- LLM (decision layer) ---
# Used only when a position is at risk, to decide the cheapest fix.
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Optional: route Anthropic calls through a proxy/router (OpenAI-compatible base
# URL of an Anthropic-compatible gateway). Leave as-is to hit api.anthropic.com.
BASE_URL=https://your_router_base_url_here

# --- Guardian tuning ---
# Health factor below this = at risk (Aave liquidates at 1.0). Act with a safety margin.
HEALTH_FACTOR_THRESHOLD=1.15
# Target health factor to restore to after a fix.
HEALTH_FACTOR_TARGET=1.5

# --- Monitor workflow (the "watches" half, deployed to KeeperHub) ---
# Cron for the Schedule trigger, UTC. Default: every 10 minutes.
SCHEDULE_CRON=*/10 * * * *
# Optional: only used with `npm run deploy-workflow -- --with-http`. The in-workflow
# HTTP handoff node is a KeeperHub *Pro* feature; on the free plan the monitor ends
# at the Condition and the Guardian is triggered out-of-band, so you can leave this
# unset. On Pro, point it at a tunnel to your Guardian, or a webhook.site URL to
# watch the payload during the demo. Not a secret.
GUARDIAN_WEBHOOK_URL=https://your_guardian_webhook_here
