{
  "name": "liquidation-guardian",
  "version": "0.1.0",
  "description": "An AI agent that keeps DeFi borrow positions safe from liquidation, executing the fix onchain through KeeperHub.",
  "type": "module",
  "scripts": {
    "first-tx": "tsx scripts/first-tx.ts",
    "read-position": "tsx scripts/read-position.ts",
    "setup-position": "tsx scripts/setup-position.ts",
    "guardian": "tsx src/agent/guardian.ts",
    "probe:llm": "tsx scripts/probe-llm.ts",
    "mcp-probe": "tsx scripts/mcp-probe.ts",
    "workflow-probe": "tsx scripts/workflow-probe.ts",
    "kh": "tsx scripts/cli.ts",
    "test-sizing": "tsx scripts/test-sizing.ts",
    "test-mcp": "tsx scripts/test-mcp.ts",
    "test-audit": "tsx scripts/test-audit.ts",
    "test-verification": "tsx scripts/test-verification.ts",
    "test-verify-negative": "tsx scripts/test-verify-negative.ts",
    "test-supply-live": "tsx scripts/test-supply-live.ts",
    "test-watcher-state": "tsx scripts/test-watcher-state.ts",
    "test-rescue-lock": "tsx scripts/test-rescue-lock.ts",
    "test-rescue-lock-redis": "tsx scripts/test-rescue-lock-redis.ts",
    "verify-demo": "tsx scripts/verify-demo.ts",
    "workflow-showcase": "tsx scripts/workflow-showcase.ts",
    "test-security": "tsx scripts/test-security.ts",
    "test": "npm run test-verification && npm run test-watcher-state && npm run test-rescue-lock && npm run test-security && npm run test-mcp && npm run test-audit && npm run test-sizing && npm run typecheck",
